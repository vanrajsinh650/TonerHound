  "experiment_id": "EXP-013",
  "title": "Candidate Generation Recovery",
  "status": "COMPLETED",
  "phase": "Phase 2 Complete — Focused Cohort & 32-Doc Regression Gate Verified (STOPPED before 370-Doc Benchmark per Instructions)",
  "started": "2026-09-20",
  "baseline_experiment": "EXP-011 + EXP-012",
  "target_cohort": "Focused flat-form failure cohort (34 docs) and 32-doc frozen regression gate",
  "primary_metric": "Candidate Recall@5 (Reference ~96.36% macro / ~61.34% on 32-doc baseline / ~36.73% on focused cohort)",
  "hypothesis": "The next major performance ceiling on ExtractBench is candidate generation, not candidate ranking. Physical evidence present in document text and OCR glyphs is absent or fragmented in candidate pools across 5 distinct failure classes. Recovering these candidates at generation time will lift Candidate Recall@5, Recall@1, and downstream Word Grounding F1 without degrading precision or introducing template-specific rules.",
  "priority_failure_classes": [
    {
      "class_id": 1,
      "name": "Spaced-token numeric recovery",
      "example": "'3 3 . 3 3 3 3 %' recovered as 33.3333%",
      "description": "OCR/PDF text stream tokenizes each digit or separator into isolated tokens; standard candidate generators look for contiguous strings and miss them."
    },
    {
      "class_id": 2,
      "name": "OCR-fragmented numeric values",
      "example": "'-3' + '186' -> -3186 or '21,' + '693.' -> 21693",
      "description": "Negative signs, currency symbols, and thousands separators cause token splits where neither piece alone matches the target value."
    },
    {
      "class_id": 3,
      "name": "Split currency and percentage tokens",
      "example": "'33.3333333' + '%' -> unified bounding box covering both value and unit",
      "description": "Units detached by small spatial gaps (<= 0.035 document width) cause ground truth bounding box mismatch if not absorbed into the candidate span."
    },
    {
      "class_id": 4,
      "name": "Fragmented multi-token field values (interleaved sub-rows)",
      "example": "'TELCO EXPERTS LLC' interleaved with street address tokens in reading order",
      "description": "Multi-column or complex sub-row layouts place tokens from different semantic fields in the same reading order line; resolved by horizontal y-band sub-band clustering."
    },
    {
      "class_id": 5,
      "name": "Bounded character-span matching with missing anchor tokens",
      "example": "'Fruitland Park FL 34731' matching when leading token is OCR-corrupted ('itland')",
      "description": "High-confidence sub-spans recovered when an anchor token is missing or corrupted, falling back gracefully without false positives."
    }
  ],
